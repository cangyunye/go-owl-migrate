      "id": "migrate",
      "label": "上层迁移流水线（零改动）"
    },
    {
      "id": "godrv",
      "label": "Go 驱动层 internal/agent"
    },
    {
      "id": "jvm",
      "label": "JVM Sidecar jvm/owl-agent"
    }
  ],
  "phases": [
    {
      "id": "access",
      "label": "接入与进程复用",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "session",
      "label": "会话与语句下发",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "streaming",
      "label": "执行与流式回传",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "pipeline",
    "sqlopen",
    "manager",
    "sidecar",
    "connect",
    "dispatch",
    "rewrite",
    "jdbc",
    "stream",
    "consume"
  ],
  "nodes": [
    {
      "id": "pipeline",
      "lane": "migrate",
      "col": 0,
      "type": "frontend",
      "label": "上层迁移流水线",
      "sublabel": "只消费 *sql.DB",
      "width": 145
    },
    {
      "id": "sqlopen",
      "lane": "godrv",
      "col": 0,
      "type": "backend",
      "label": "sql.Open(\"owljdbc\", DSN)",
      "sublabel": "DSN = JSON Config",
      "width": 170
    },
    {
      "id": "manager",
      "lane": "godrv",
      "col": 1,
      "type": "backend",
      "label": "Manager.Acquire",
      "sublabel": "profile 复用 · refs 计数",
      "width": 155
    },
    {
      "id": "sidecar",
      "lane": "jvm",
      "col": 1,
      "type": "backend",
      "label": "JVM Sidecar",
      "sublabel": "spawn owl.agent.Main",
      "width": 150
    },
    {
      "id": "connect",
      "lane": "jvm",
      "col": 2,
      "type": "backend",
      "label": "CONNECT 建会话",
      "sublabel": "凭证仅经 stdin 首帧",
      "width": 150
    },
    {
      "id": "dispatch",
      "lane": "godrv",
      "col": 2,
      "type": "backend",
      "label": "QUERY / EXEC 下发",
      "sublabel": "req-id 匹配 · 会话内串行",
      "width": 160
    },
    {
      "id": "rewrite",
      "lane": "jvm",
      "col": 3,
      "type": "security",
      "label": "BindRewriter",
      "sublabel": "oracle :N → ? 改写",
      "width": 140
    },
    {
      "id": "cancel",
      "lane": "godrv",
      "col": 3,
      "type": "backend",
      "label": "ctx 取消 / 超时",
      "sublabel": "CANCEL → Statement.cancel",
      "width": 150
    },
    {
      "id": "jdbc",
      "lane": "jvm",
      "col": 4,
      "type": "backend",
      "label": "JDBC 执行",
      "sublabel": "PreparedStatement · 按库 jar",
      "width": 150
    },
    {
      "id": "stream",
      "lane": "godrv",
      "col": 4,
      "type": "messagebus",
      "label": "ROW_BATCH 流式回传",
      "sublabel": "decimal 走 string · END",
      "width": 160
    },
    {
      "id": "consume",
      "lane": "migrate",
      "col": 5,
      "type": "frontend",
      "label": "上层零改动消费",
      "sublabel": "CSV 导出 · 批量导入",
      "width": 150
    },
    {
      "id": "crash",
      "lane": "godrv",
      "col": 5,
      "type": "external",
      "label": "进程死亡 fail-fast",
      "sublabel": "EOF → abortAll · 不重连",
      "width": 155
    }
  ],
  "edges": [
    {
      "id": "open",
      "from": "pipeline",
      "to": "sqlopen"
    },
    {
      "id": "acquire",
      "from": "sqlopen",
      "to": "manager"
    },
    {
      "id": "spawn",
      "from": "manager",
      "to": "sidecar",
      "label": "首次 spawn · PING"
    },
    {
      "id": "handshake",
      "from": "sidecar",
      "to": "connect"
    },
    {
      "id": "ready",
      "from": "connect",
      "to": "dispatch",
      "label": "Conn 就绪"
    },
    {
      "id": "submit",
      "from": "dispatch",
      "to": "rewrite",
      "label": "SQL + 参数",
      "route": "drop"
    },
    {
      "id": "rewritten",
      "from": "rewrite",
      "to": "jdbc",
      "label": "改写后 SQL"
    },
    {
      "id": "frames",
      "from": "jdbc",
      "to": "stream"
    },
    {
      "id": "rows",
      "from": "stream",
      "to": "consume",
      "label": "逐行"
    },
    {
      "id": "cancel-edge",
      "from": "dispatch",
      "to": "cancel",
      "label": "ctx 取消",
      "role": "branch"
    },
    {
      "id": "crash-edge",
      "from": "stream",
      "to": "crash",
      "label": "进程死亡",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "通道不变量",
      "items": [
        "下游只消费 *sql.DB：注册 owljdbc 即接入，上层四层零改动",
        "DSN = JSON Config（driverClass · url · user · password · family · classpath）",
        "凭证仅经 stdin 首帧下发，不进 argv / env；oracle :N → ? 改写跳过字面量 / 注释 / ::"
      ]
    },
    {
      "dot": "rose",
      "title": "生命周期与故障",
      "items": [
        "1 profile = 1 JVM：spawn `java -cp owl-agent.jar:<driver-jars> owl.agent.Main`（JRE 8+，PING 握手 30s）；refs=0 → 进程 Kill",
        "同 session 串行、跨 session 并行；CANCEL → Statement.cancel；EOF / 帧损坏 → abortAll 不重连；帧上限 16 MiB"
      ]
    },
    {
      "dot": "emerald",
      "title": "通用性与验收（阶段一）",
      "items": [
        "接入新库 = 驱动 jar + family + URL：OB 双租户 / MySQL 8.4 / PG 16.3 已验证，Oracle / TimesTen / GoldenDB 登记未测",
        "OB 对拍：元数据一致 · 50k 行 CSV 逐字节一致 · 导入计数一致；吞吐 0.14–0.30× native"
      ]
    }
  ]
}