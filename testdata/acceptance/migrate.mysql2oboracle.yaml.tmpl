# migrate · MySQL(owl_accept) → OceanBase-Oracle(MIGSRC)
# 需 -tags ob 构建的二进制（目标方言/驱动）；agent 通道的源读取无需 tag。
general:
  log_level: info
metadata:
  type: database
ddl:
  target_dialect: oceanbase-oracle
  schema_mapping:
    owl_accept: MIGSRC
agent:
  jars_dir: "."
  agent_jar: "owljdbc/jvm/owl-agent/owl-agent.jar"
source:
  type: mysql
  dsn: "__DSN__owl_accept"
  schema: "owl_accept"
target:
  type: oceanbase-oracle
  dsn: "__MIGSRC_DSN__"
import:
  csv:
    delimiter: ","
    null_marker: "\\N"
  target:
    truncate_before: true
  batch:
    commit_interval: 100
    error_policy: stop
